    {
      "ticket": "103",
      "prompt": "Using the campus-customs MCP server, how many CC-HOOD-NAVY hoodies in size M do we have on hand?",
      "tool_name": "check_stock",
      "tool_input": {
        "sku": "CC-HOOD-NAVY",
        "size": "M"
      },
      "tool_output": {
        "found": true,
        "sku": "CC-HOOD-NAVY",
        "name": "Basic Hoodie Big Yale",
        "size": "M",
        "qty": 8,
        "location": "Aisle A"
      },
      "database_check": {
        "tables": "inventory",
        "database_values": {
          "sku": "CC-HOOD-NAVY",
          "name": "Basic Hoodie Big Yale",
          "size": "M",
          "qty": 8,
          "location": "Aisle A"
        },
        "matches": true
      },
      "connection_status": "connected"
    },
    {
